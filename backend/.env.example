# ─────────────────────────────────────────────────────────────
# Backend Environment Variables — copy to .env and fill in values
# NEVER commit the actual .env file to source control
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# PostgreSQL connection string
# Local: postgresql://postgres:password@localhost:5432/ai_pr_reviewer
# Render: provided automatically when using render.yaml
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ai_pr_reviewer

# GitHub App credentials
# Get these from https://github.com/settings/apps after creating your app
GITHUB_APP_ID=

# The private key is a multi-line PEM. In .env, replace newlines with \n
# Example: -----BEGIN RSA PRIVATE KEY-----\nMIIEow...base64...\n-----END RSA PRIVATE KEY-----
GITHUB_PRIVATE_KEY=

# Generate a random secret: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Get from https://console.groq.com
GROQ_API_KEY=

# Available models: deepseek-r1-distill-llama-70b, llama-3.1-70b-versatile
GROQ_MODEL=deepseek-r1-distill-llama-70b

# Your Netlify frontend URL — set this after Netlify deploy to tighten CORS
# Example: https://ai-pr-reviewer-abc123.netlify.app
FRONTEND_URL=
