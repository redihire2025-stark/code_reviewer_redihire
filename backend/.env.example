# ─────────────────────────────────────────────────────────────
# Backend Environment Variables
# FREE STACK: Neon (DB) + Render (API) + Netlify (UI) + Groq (AI)
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# ── Neon PostgreSQL (free at neon.tech) ──────────────────────
# 1. Sign up at https://neon.tech (no credit card)
# 2. Create a project → go to Dashboard → Connection Details
# 3. Select "Prisma" from the connection string dropdown
# 4. Copy BOTH strings below:

# Pooled connection (used at runtime by the app)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true

# Direct connection (used by Prisma migrations)
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── GitHub App ───────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── Groq AI (free at console.groq.com) ───────────────────────
GROQ_API_KEY=
GROQ_MODEL=deepseek-r1-distill-llama-70b

# ── Frontend URL (set after Netlify deploy) ───────────────────
FRONTEND_URL=
