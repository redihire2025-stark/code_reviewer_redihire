generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Repository {
  id             String   @id @default(cuid())
  githubId       BigInt   @unique @map("github_id")
  fullName       String   @unique @map("full_name")
  owner          String
  name           String
  installationId BigInt   @map("installation_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  pullRequests PullRequest[]
  codingRules  CodingRule[]

  @@index([installationId])
  @@map("repositories")
}

model PullRequest {
  id         String   @id @default(cuid())
  githubPrId BigInt   @map("github_pr_id")
  number     Int
  title      String
  author     String
  headSha    String   @map("head_sha")
  baseBranch String   @map("base_branch")
  headBranch String   @map("head_branch")
  state      String   @default("open")
  htmlUrl    String   @map("html_url")
  isDraft    Boolean  @default(false) @map("is_draft")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  repositoryId String     @map("repository_id")
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  reviews Review[]

  @@unique([repositoryId, number])
  @@index([author])
  @@index([headSha])
  @@map("pull_requests")
}

model Review {
  id             String    @id @default(cuid())
  headSha        String    @map("head_sha")
  status         String    @default("pending")
  overallScore   Float?    @map("overall_score")
  filesReviewed  Int       @default(0) @map("files_reviewed")
  totalComments  Int       @default(0) @map("total_comments")
  criticalCount  Int       @default(0) @map("critical_count")
  highCount      Int       @default(0) @map("high_count")
  mediumCount    Int       @default(0) @map("medium_count")
  lowCount       Int       @default(0) @map("low_count")
  summaryBody    String?   @map("summary_body")
  githubReviewId BigInt?   @map("github_review_id")
  errorMessage   String?   @map("error_message")
  processingMs   Int?      @map("processing_ms")
  tokensUsed     Int?      @map("tokens_used")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  pullRequestId String      @map("pull_request_id")
  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  comments ReviewComment[]
  metrics  ReviewMetrics?

  @@unique([pullRequestId, headSha])
  @@index([status])
  @@index([createdAt])
  @@map("reviews")
}

model ReviewComment {
  id              String   @id @default(cuid())
  filePath        String   @map("file_path")
  line            Int?
  severity        String
  category        String
  problem         String
  whyItMatters    String   @map("why_it_matters")
  suggestedFix    String   @map("suggested_fix")
  improvedCode    String?  @map("improved_code")
  learningInsight String   @map("learning_insight")
  githubCommentId BigInt?  @map("github_comment_id")
  createdAt       DateTime @default(now()) @map("created_at")

  reviewId String @map("review_id")
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([severity])
  @@index([category])
  @@index([filePath])
  @@map("review_comments")
}

model ReviewMetrics {
  id             String   @id @default(cuid())
  bugsFound      Int      @default(0) @map("bugs_found")
  tsIssues       Int      @default(0) @map("ts_issues")
  reactIssues    Int      @default(0) @map("react_issues")
  perfIssues     Int      @default(0) @map("perf_issues")
  securityIssues Int      @default(0) @map("security_issues")
  archIssues     Int      @default(0) @map("arch_issues")
  qualityIssues  Int      @default(0) @map("quality_issues")
  testingIssues  Int      @default(0) @map("testing_issues")
  strengths      String[]
  improvements   String[]
  learningRecs   String[] @map("learning_recs")

  reviewId String @unique @map("review_id")
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_metrics")
}

model CodingRule {
  id           String   @id @default(cuid())
  content      String
  fileSha      String   @map("file_sha")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  repositoryId String     @unique @map("repository_id")
  repositoryDb Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@map("coding_rules")
}
