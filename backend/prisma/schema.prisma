// This is the Prisma schema for the AI PR Reviewer platform.
// It defines all database tables, relationships, and indexes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Repository {
  id             String   @id @default(cuid())
  githubId       Int      @unique @map("github_id")
  fullName       String   @unique @map("full_name") // e.g. "owner/repo"
  owner          String
  name           String
  installationId Int      @map("installation_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  pullRequests PullRequest[]
  codingRules  CodingRule[]

  @@index([installationId])
  @@map("repositories")
}

model PullRequest {
  id           String   @id @default(cuid())
  githubPrId   Int      @map("github_pr_id")
  number       Int
  title        String
  author       String
  headSha      String   @map("head_sha")
  baseBranch   String   @map("base_branch")
  headBranch   String   @map("head_branch")
  state        String   @default("open") // open | closed | merged
  htmlUrl      String   @map("html_url")
  isDraft      Boolean  @default(false) @map("is_draft")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  repositoryId String     @map("repository_id")
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  reviews Review[]

  @@unique([repositoryId, number])
  @@index([author])
  @@index([headSha])
  @@map("pull_requests")
}

model Review {
  id              String   @id @default(cuid())
  // Idempotency: one review per (PR, commit SHA)
  headSha         String   @map("head_sha")
  status          String   @default("pending") // pending | processing | completed | failed
  overallScore    Float?   @map("overall_score") // 0-10
  filesReviewed   Int      @default(0) @map("files_reviewed")
  totalComments   Int      @default(0) @map("total_comments")
  criticalCount   Int      @default(0) @map("critical_count")
  highCount       Int      @default(0) @map("high_count")
  mediumCount     Int      @default(0) @map("medium_count")
  lowCount        Int      @default(0) @map("low_count")
  summaryBody     String?  @map("summary_body") // The full summary posted to GitHub
  githubReviewId  Int?     @map("github_review_id") // GitHub review ID after posting
  errorMessage    String?  @map("error_message")
  processingMs    Int?     @map("processing_ms") // How long the review took
  tokensUsed      Int?     @map("tokens_used") // Groq token consumption
  createdAt       DateTime @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  pullRequestId String      @map("pull_request_id")
  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  comments ReviewComment[]
  metrics  ReviewMetrics?

  @@unique([pullRequestId, headSha])
  @@index([status])
  @@index([createdAt])
  @@map("reviews")
}

model ReviewComment {
  id            String  @id @default(cuid())
  filePath      String  @map("file_path")
  line          Int?    // null = general file comment
  severity      String  // Critical | High | Medium | Low
  category      String  // Bugs | TypeScript | React | Performance | Security | Architecture | CodeQuality | Testing
  problem       String
  whyItMatters  String  @map("why_it_matters")
  suggestedFix  String  @map("suggested_fix")
  improvedCode  String? @map("improved_code")
  learningInsight String @map("learning_insight")
  githubCommentId Int?  @map("github_comment_id")
  createdAt     DateTime @default(now()) @map("created_at")

  reviewId String @map("review_id")
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([severity])
  @@index([category])
  @@index([filePath])
  @@map("review_comments")
}

model ReviewMetrics {
  id              String @id @default(cuid())
  bugsFound       Int    @default(0) @map("bugs_found")
  tsIssues        Int    @default(0) @map("ts_issues")
  reactIssues     Int    @default(0) @map("react_issues")
  perfIssues      Int    @default(0) @map("perf_issues")
  securityIssues  Int    @default(0) @map("security_issues")
  archIssues      Int    @default(0) @map("arch_issues")
  qualityIssues   Int    @default(0) @map("quality_issues")
  testingIssues   Int    @default(0) @map("testing_issues")
  strengths       String[] // Array of positive observations
  improvements    String[] // Array of improvement recommendations
  learningRecs    String[] @map("learning_recs")

  reviewId String @unique @map("review_id")
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_metrics")
}

model CodingRule {
  id           String   @id @default(cuid())
  content      String   // Full markdown content of .ai-review/rules.md
  fileSha      String   @map("file_sha") // GitHub blob SHA for cache invalidation
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  repositoryId String     @unique @map("repository_id")
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@map("coding_rules")
}
